.env
.env.*
*.pem
*.key
*.p12
*.pfx

# logs & junk
*.log
node_modules/
*.tgz
dist/
build/
coverage/

# installer / consumer-project artifacts
.mal-agents-installed
.reviewfix/
CONTEXT.md
CONTEXT-MAP.md
