# ─────────────────────────────────────────────────────────────────────────────
# mal-agents — .gitignore
# Full secure, full safe, cross-environment. Covers OS + editor junk, secrets,
# logs, and the files our own skills generate inside *your* projects.
# ─────────────────────────────────────────────────────────────────────────────

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
Icon\r
.LSOverride

# ── Editors — everyone gets a home. Especially you, vim folks. 💚 ────────────
# Vim / Neovim
*.swp
*.swo
*~
.*.sw[op]
tags~
autoload/netrwhist
netrwhist
*.viminfo
.viminfo
session.vim
.vim/backups/
.vim/swaps/
.vim/undo/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# JetBrains (GoLand / IntelliJ / WebStorm / PyCharm / ...)
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Zed
.zed/
*.zed-workspace

# Nano
.nano_history

# Global editor lock/cache
.*.swp
.#*

# ── Shell & env cruft ────────────────────────────────────────────────────────
.bash_history
.zsh_history
.fish_history
.fish_saved_history
# --- snippet ---
# fish user paths (may hold machine-local overrides)
fish_variables

# ── Secrets & keys (no exceptions) ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.secret
id_rsa
id_ed25519
*.local.env

# ── Logs & temp ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp.orig

# ── Language / tooling cruft (defensive — this repo has no deps) ─────────────
node_modules/
jspm_packages/
dist/
build/
coverage/
.nyc_output/
*.tgz
*.tsbuildinfo
.eslintcache
.pnpm-store/

# ── Generated by our own skills (in consumer projects) ───────────────────────
.reviewfix/
.cursor/reviews/
CONTEXT.md
CONTEXT-MAP.md
docs/adr/

# ── Installer artifacts ──────────────────────────────────────────────────────
.mal-agents-installed
AGENTS.md
# ─────────────────────────────────────────────────────────────────────────────
#  A gentle note for the vim/emacs souls who find this file: yes, *.swp and
#  *~ are ignored. Go forth and <Esc>:wq in peace. — mal-agents 🐟
# ─────────────────────────────────────────────────────────────────────────────
